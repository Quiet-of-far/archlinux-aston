 void ggml_hexagon_session::enqueue_op(const htp_opnode & node) {
+    static const size_t host_window = []() {
+        const char * value = getenv("ACE3_HTP_HOST_WINDOW_MB");
+        return value ? strtoul(value, nullptr, 10) * 1024 * 1024 : size_t(0);
+    }();
+    static const size_t large_weight_limit = []() {
+        const char * value = getenv("ACE3_HTP_HOST_LARGE_MB");
+        return (value ? strtoul(value, nullptr, 10) : 64) * 1024 * 1024;
+    }();
+    if (host_window) {
+        GGML_ASSERT(opt_ndev == 1 && mdev.count <= 1);
+        std::unordered_set<ggml_hexagon_shared_buffer *> required;
+        auto collect = [&](const ggml_tensor * t) {
+            if (t && t->buffer && ggml_backend_buffer_get_usage(t->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+                auto * sbuf = static_cast<ggml_hexagon_shared_buffer *>(t->buffer->context);
+                GGML_ASSERT(sbuf->sess == this);
+                required.insert(sbuf);
+            }
+        };
+        for (auto * t : node.get_inputs())  collect(t);
+        for (auto * t : node.get_outputs()) collect(t);
+        size_t needed = 0;
+        bool large_new_weight = false;
+        for (auto * sbuf : mapped_weights) needed += sbuf->size();
+        for (auto * sbuf : required) {
+            if (!sbuf->mapped) {
+                needed += sbuf->size();
+                large_new_weight |= sbuf->size() > large_weight_limit;
+            }
+        }
+        if (needed > host_window || large_new_weight) {
+            // Drain pending DSP work before removing host IOMMU mappings.
+            flush_sync(true);
+            const auto old_weights = mapped_weights;
+            for (auto * sbuf : old_weights) {
+                if (!required.count(sbuf) && !sbuf->pinned) sbuf->unmap();
+            }
+        }
+        size_t required_size = 0;
+        for (auto * sbuf : required) required_size += sbuf->size();
+        GGML_ASSERT(required_size <= host_window);
+    }
     auto clone_tensor_buffer = [this](const ggml_tensor * t) {
         auto sbuf = this->mmap_tensor(t);
         if (!sbuf) return;
@@ -3942,6 +3985,9 @@ ggml_hexagon_shared_buffer * ggml_hexagon_session::mmap_tensor(const ggml_tensor
         const bool extended  = opt_dma64 && is_weight;
         sbuf->mmap(extended);
     }
+    if (ggml_backend_buffer_get_usage(t->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+        sbuf->sess->mapped_weights.insert(sbuf);
+    }
     return sbuf;
 }
 
