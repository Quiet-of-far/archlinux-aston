 enum ggml_status ggml_graph_compute(struct ggml_cgraph * cgraph, struct ggml_cplan * cplan) {
+    const char * strict_htp = getenv("ACE3_HTP_STRICT");
+    if (strict_htp && strcmp(strict_htp, "1") == 0) {
+        for (int i = 0; i < cgraph->n_nodes; ++i) {
+            const struct ggml_tensor * node = cgraph->nodes[i];
+            if (node->op != GGML_OP_NONE && node->op != GGML_OP_RESHAPE &&
+                node->op != GGML_OP_VIEW && node->op != GGML_OP_PERMUTE && node->op != GGML_OP_TRANSPOSE) {
+                GGML_LOG_ERROR("ACE3_HTP_STRICT: refused CPU operation %s (%s)\n", ggml_op_desc(node), node->name);
+                return GGML_STATUS_FAILED;
+            }
+        }
+    }
     ggml_cpu_init();
 
     GGML_ASSERT(cplan);
